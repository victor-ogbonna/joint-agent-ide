{
  "name": "joint-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:flash": "node test/avrFlash.sim.mjs",
    "test:webusb": "node test/webusb.sim.mjs",
    "test": "npm run test:flash && npm run test:webusb && npm run test:esp32 && npm run test:serial && npm run test:pump && npm run test:scrub && npm run test:commands && npm run test:monitor && npm run test:markup && npm run test:context && npm run test:tiers",
    "test:esp32": "node test/esp32.sim.mjs",
    "test:pump": "node test/pump.sim.mjs",
    "test:serial": "node test/serialLines.sim.mjs",
    "test:scrub": "tsx test/scrub.mjs",
    "test:commands": "tsx test/commands.mjs",
    "test:monitor": "node test/serialMonitor.sim.mjs",
    "test:markup": "tsx test/toolMarkup.mjs",
    "test:context": "tsx test/context.mjs",
    "test:tiers": "tsx test/tiers.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "esptool-js": "^0.6.0",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "intel-hex": "^0.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.1",
    "react-simple-code-editor": "^0.14.1",
