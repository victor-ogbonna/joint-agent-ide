# DEEPSEEK_API_KEY: Required. Powers the agent chat, project generation and
# debugging — everything except audio. Get one at platform.deepseek.com ->
# API Keys. Without it those endpoints fall back to offline mock responses.
DEEPSEEK_API_KEY=""

# GEMINI_API_KEY: Still required, but now ONLY for voice transcription
# (/api/ai/transcribe) — DeepSeek has no audio input, so the two providers
# run side by side. If you don't use voice commands, this can be left unset
# and only the microphone button will be unavailable.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required to sign in at /admin, where the Gemini API key can
# be viewed/changed at runtime without redeploying (useful for managing cost
# and quota). Pick a strong, unique password — anyone with it can change the
# key the whole app uses. Leave unset to disable the admin page entirely.
ADMIN_PASSWORD=""

# RENDER_API_KEY / RENDER_SERVICE_ID: Optional. Without these, changes made
# on the /admin page (Gemini key, Paystack keys) still take effect
# immediately but only until the next restart, then silently revert — Render's
# filesystem is ephemeral. Set both and admin-page saves are instead written
# to this service's real Render environment variables and applied with a
# quick redeploy (reuses the existing build, no rebuild), so they actually
# persist. Get RENDER_API_KEY from Render's dashboard -> Account Settings ->
# API Keys. Get RENDER_SERVICE_ID from this service's own dashboard URL
# (the "srv-..." segment) or the service's Settings page.
RENDER_API_KEY=""
RENDER_SERVICE_ID=""

# FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY:
# Required for server-side auth verification and the token-usage paywall.
# Download once from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key, then copy the matching 3 fields from that JSON
# file here. Paste FIREBASE_PRIVATE_KEY exactly as it appears in the JSON
# (including the literal \n sequences and the BEGIN/END PRIVATE KEY lines) —
# it's restored to real newlines at runtime. Without these, sign-in-gated AI
# endpoints and the paywall respond 503.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# PAYSTACK_SECRET_KEY / PAYSTACK_PUBLIC_KEY / PAYSTACK_PLAN_CODE:
# Optional fallback for the $3/month subscription paywall — a value saved via
# the admin page takes priority over these, same override pattern as
# GEMINI_API_KEY. PAYSTACK_PLAN_CODE comes from the recurring Plan created on
# the Paystack dashboard (test-mode keys/plan work fine before your Paystack
# account finishes live activation). Leave unset and the Subscribe button
# will show a "not configured yet" state instead of crashing.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_PLAN_CODE=""

# --- GitHub integration (optional) -------------------------------------------
# Create an OAuth App at https://github.com/settings/developers with the
# callback URL  <APP_URL>/api/github/callback  e.g.
#   https://jointagentide.com/api/github/callback
# Without these two the Push to GitHub panel shows setup instructions instead
# of a broken button; nothing else is affected.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Encrypts stored GitHub tokens at rest and signs the OAuth state.
# Falls back to GITHUB_CLIENT_SECRET when unset; set it to any long random
# string if you want the two to be independent.
GITHUB_TOKEN_SECRET=
