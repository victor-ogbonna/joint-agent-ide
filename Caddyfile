# Joint-Agent IDE — reverse proxy and automatic HTTPS.
#
# jointagentide.com is the only domain served (cutover completed 13 Sep 2026).
# afrojoint.xyz was dropped once Google sign-in was confirmed working here —
# verified by reaching the consent screen and reading "to continue to
# jointagentide.com" with no redirect_uri_mismatch.
#
# afrojoint.xyz DNS still points at this server, so requests for it now reach
# Caddy and match no site. Remove those A records in Cloudflare to tidy up. Caddy requests and renews the
# Let's Encrypt certificate automatically — nothing to renew by hand.
#
# The A records for both names must resolve to this server, and Cloudflare's
# proxy must stay OFF ("DNS only", grey cloud). With the orange proxy on,
# Cloudflare terminates TLS itself and Caddy's certificate challenge fails.

jointagentide.com, www.jointagentide.com {
	# `app` resolves over the compose network; 8080 is never exposed to the host.
	reverse_proxy app:8080 {
		# The agent streams responses over server-sent events. Without this,
		# Caddy buffers them and the whole reply lands at once at the end,
		# which reads as the agent hanging and then dumping — the streaming
		# effect disappears entirely.
		flush_interval -1
	}

	encode gzip

	header {
		# Basic hardening. HSTS: once a browser has been here over HTTPS, it
		# never tries plain HTTP for this site again (for a year), so nobody on
		# the same Wi-Fi can serve it a fake page. Only these two names, not
		# other subdomains.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The HTML shell must never be reused from cache. Its whole job is to name
	# the current hashed bundle, so a stale copy pins the browser to an old
	# build of the app — which happened: a phone kept running superseded
	# flasher code for several rounds of debugging while reporting symptoms
	# that had already been fixed. "max-age=0" asks for revalidation; mobile
	# browsers do not always oblige. "no-store" leaves no room for
	# interpretation.
	@html {
		path / /index.html /waitlist /privacy /thanks /admin /share/*
	}
	# ">" REPLACES the header. Without it Caddy appends, and the app server's
	# own "public, max-age=0" stayed alongside ours — two conflicting
	# Cache-Control values in one response, with the browser free to honour
	# either. Verified against the live site: exactly one now.
	header @html >Cache-Control "no-store, must-revalidate"

	# Asset filenames carry a content hash, so they can be cached hard and
	# forever — a changed file gets a different name.
	@hashed path /assets/*
	header @hashed >Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
